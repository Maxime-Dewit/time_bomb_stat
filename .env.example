# Copier ce fichier en `.env` pour le développement local.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vide = SQLite local (db.sqlite3). Exemple Postgres :
# DATABASE_URL=postgres://user:password@localhost:5432/timebomb
DATABASE_URL=
# Origines autorisées pour le CSRF en prod (https://stats.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Paris
